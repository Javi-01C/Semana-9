#  SECCIÓN 1: MERGE SORT (IMPLEMENTACIÓN PARAMETRIZADA)

# COMPRENDE-1: ¿Qué propiedad garantiza que merge() siempre produce un subarreglo ordenado?
# Garantiza el ordenamiento porque asume como precondición matemática que los dos subarreglos de entrada ya se encuentran ordenados de forma independiente.
# Al estar preordenados, el algoritmo solo requiere comparar los elementos del frente de cada subarreglo para construir la unión ordenada.

# COMPRENDE-2: ¿Por qué el árbol de recursión tiene altura log₂(n) y qué implica eso para la complejidad total?
# La altura es exactamente log₂(n) debido a que el espacio del problema se reduce dividiéndose estrictamente entre 2 en cada nivel de recursión.
# Esto implica que existen log₂(n) niveles, y como cada nivel requiere un trabajo lineal de fusión O(n), la complejidad temporal total queda acotada en O(n log n).

def merge_sort(arr: list, inicio: int, fin: int, key=None) -> None:
    """
    Ordena arr[inicio..fin] usando Merge Sort de manera in-place mediante índices.
    DECISIÓN: Se utilizan índices explícitos para evitar el costo de reasignación y copia por slicing del arreglo en cada llamada.
    """
    if inicio >= fin:
        return  # Caso base

    # División entera pura para evitar índices flotantes en Python 3
    medio = (inicio + fin) // 2

    merge_sort(arr, inicio, medio, key)       # Subárbol recursivo izquierdo
    merge_sort(arr, medio + 1, fin, key)   # Subárbol recursivo derecho
    merge(arr, inicio, medio, fin, key)


def merge(arr: list, inicio: int, medio: int, fin: int, key=None) -> None:
    """
    Fusiona dos subarreglos ordenados: arr[inicio..medio] y arr[medio+1..fin].
    DECISIÓN: Copia los elementos a arreglos temporales para evitar la sobreescritura destructiva de punteros de lectura.
    """
    # COMPRENDE-3: Invariante del ciclo de fusión:
    # Confirmación de la invariante: Es correcta. El ciclo selecciona el mínimo absoluto entre los frentes de los arreglos 
    # auxiliares, garantizando que el segmento reconstruido arr[inicio..k-1] sea monótonamente creciente.

    izquierda = arr[inicio:medio + 1]
    derecha   = arr[medio + 1:fin + 1]

    i = 0; j = 0; k = inicio

    while i < len(izquierda) and j < len(derecha):
        val_izq = key(izquierda[i]) if key else izquierda[i]
        val_der = key(derecha[j]) if key else derecha[j]

        # Operador '<=' garantiza la estabilidad algorítmica preservando el orden original relativo
        if val_izq <= val_der:
            arr[k] = izquierda[i]
            i += 1
        else:
            arr[k] = derecha[j]
            j += 1
        k += 1

    while i < len(izquierda):
        arr[k] = izquierda[i]
        i += 1; k += 1

    while j < len(derecha):
        arr[k] = derecha[j]
        j += 1; k += 1


