def experimento_estabilidad_streamMX():
    """
    RETO 2: Experimento avanzado automatizado para la plataforma StreamMX.
    """
    streamMX_datos = [
        {"titulo": "Peli_Retro_A", "fecha": 1995, "puntaje": 9.2, "orden_cronologico": 1},
        {"titulo": "Peli_Retro_B", "fecha": 1998, "puntaje": 8.5, "orden_cronologico": 2},
        {"titulo": "Peli_Moderna_C", "fecha": 2015, "puntaje": 9.2, "orden_cronologico": 3},  # Empate puntaje con A
        {"titulo": "Peli_Moderna_D", "fecha": 2020, "puntaje": 8.5, "orden_cronologico": 4},  # Empate puntaje con B
    ]

    # Ordenamiento por puntaje inverso (Descendente)
    merge_sort(streamMX_datos, 0, len(streamMX_datos) - 1, key=lambda x: x["puntaje"] * -1)

    for i in range(len(streamMX_datos) - 1):
        actual = streamMX_datos[i]
        siguiente = streamMX_datos[i + 1]
        if actual["puntaje"] == siguiente["puntaje"]:
            assert actual["orden_cronologico"] < siguiente["orden_cronologico"], "Error en estabilidad"


#  SECCIÓN 3: PROFUNDIZA — DIAGNÓSTICO DE RESTRICCIÓN DE MEMORIA


# # PROFUNDIZA: El consumo de RAM auxiliar en Merge Sort no alcanza su pico máximo global en las hojas del árbol (donde los subarreglos
# son de tamaño 1), sino en el nivel raíz del árbol de recursión, específicamente al momento de invocar la última llamada a merge() sobre el
# arreglo total. En ese instante, el sistema se ve forzado a duplicar exactamente la memoria asignada, requiriendo un espacio adicional de O(n).
# No es matemáticamente viable reducir la memoria auxiliar a O(1) manteniendo el paradigma puro de fusión externa, debido a que el algoritmo 
# requiere un búfer de aislamiento para evitar colisiones de sobreescritura destructiva de datos mientras desplaza los elementos.
# El algoritmo ideal para mitigar este colapso en los servidores de StreamMX debe implementar la propiedad de ordenamiento in-place (en sitio) 
# y adaptabilidad al estado inicial de la entrada. Este sistema óptimo procesará colecciones en tiempo promedio de O(n log n) utilizando un espacio 
# auxiliar acotado a O(log n) o menos. Reducir el consumo espacial a O(log n) en lugar de O(n) implicaría una cuantificación de ahorro masiva para 
# 4 millones de registros: el uso de RAM auxiliar caería desde un peso lineal simétrico completo a solo el costo Stack de la profundidad recursiva 
# (apenas ~22 marcos de ejecución en memoria), eliminando por completo el riesgo de saturación del servidor.


